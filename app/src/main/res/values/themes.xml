<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kairos" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/kairos_window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Kairos.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kairos_icon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Kairos</item>
    </style>
</resources>
