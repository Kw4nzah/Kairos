<?xml version="1.0" encoding="utf-8"?>
<!-- Live countdown / count-up for the widget; the system ticks it, no widget updates needed. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_chrono"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:textColor="@color/widget_muted"
    android:textSize="15sp" />
